APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
APP_ENV=development
DEBUG=true
ALERT_SENDER_EMAIL=alerts@example.com
ALERT_SENDER_APP_PASSWORD=replace-with-gmail-app-password
ALERT_TEST_RECIPIENT=test-recipient@example.com
DATABASE__URL=postgresql+psycopg2://postgres_user:postgres_password@localhost:5432/iac_driftwatch
POSTGRES_HOST=localhost
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=iac_driftwatch
SECRET_KEY=replace-with-a-long-random-secret
AWS_REGION=us-east-1
CLOUD__PROVIDER=aws
CLOUD__AWS_ACCESS_KEY_ID=replace-with-aws-access-key
CLOUD__AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
DRIFT_SCAN_INTERVAL_MINUTES=15
DRIFT_EMAIL_INTERVAL_MINUTES=15
SESSION_IDLE_TTL_SECONDS=28800
